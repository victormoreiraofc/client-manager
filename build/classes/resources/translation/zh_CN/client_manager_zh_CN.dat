auth.new_event.label.description=<html><p align="center">请录入团队活动，保持公司日程为最新状态。</p></html>
auth.new_event.label.default.name=活动名称*
auth.new_event.label.default.responsible=负责人*
auth.new_event.label.default.sector=负责部门
auth.new_event.label.default.time=活动时间*
auth.new_event.label.default.date=活动日期*
auth.new_event.label.default.observation=备注
auth.new_event.label.hover.name=活动名称*
auth.new_event.label.hover.responsible=负责人*
auth.new_event.label.hover.sector=负责部门
auth.new_event.label.hover.time=活动时间*
auth.new_event.label.hover.date=活动日期*
auth.new_event.label.hover.observation=备注
auth.new_event.label.button.cancel=取消
auth.new_event.label.button.register=添加
auth.new_event.error.invalid_date=日期无效。请使用 DD/MM/YYYY 格式，例如 25/12/2026。
auth.new_event.error.invalid_time=时间无效。请使用 HH:mm 格式，例如 18:30。
auth.new_event.error.invalid_user=未找到负责人。请输入已有的用户。

auth.used_event.label.title=编辑活动
auth.used_event.label.description=<html><p align="center">请修改活动信息，保持公司日程为最新状态。</p></html>
auth.used_event.label.button.save=保存更改
auth.used_event.label.button.delete=删除

auth.used_event.confirm_delete.title=确认删除
auth.used_event.confirm_delete.message=确定要删除活动“%s”吗？
auth.used_event.confirm_delete.button.yes=是
auth.used_event.confirm_delete.button.no=否
auth.used_event.confirm_delete.success=活动已成功删除。
auth.used_event.confirm_delete.error=删除活动时出错。请检查您的网络连接。
auth.used_event.register.success=活动已成功保存。
auth.used_event.register.error=目前无法连接到数据库。请检查您的网络连接，或稍后再试。